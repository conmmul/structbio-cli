#!/usr/bin/env bash
# Generated by structbio. Regenerate with: structbio install-wrappers
# `colabfold ARGUMENTS` is exactly `structbio colabfold ARGUMENTS`.
set -euo pipefail

launcher=(structbio)
if ! command -v "${launcher[0]}" >/dev/null 2>&1; then
  echo "colabfold: cannot find structbio at '${launcher[0]}'." >&2
  echo "Activate the environment where structbio is installed, then run" >&2
  echo "structbio install-wrappers again." >&2
  exit 127
fi
if [ "$#" -eq 0 ]; then
  exec "${launcher[@]}" colabfold --help
fi
exec "${launcher[@]}" colabfold "$@"
